      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (tasque_work_lane) ((last_over_time(tasque_provider_cost_USD_total{tasque_work_lane=~\"$lane\"}[$__range]) - (last_over_time(tasque_provider_cost_USD_total{tasque_work_lane=~\"$lane\"}[$__range] offset $__range) or last_over_time(tasque_provider_cost_USD_total{tasque_work_lane=~\"$lane\"}[$__range]) * 0))))",
          "legendFormat": "{{tasque_work_lane}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
