    {
      "type": "timeseries",
      "title": "Cost per day",
      "description": "Estimated cost of model runs per day (UTC days).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "maxDataPoints": 400,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((last_over_time(tasque_provider_cost_USD_total{tasque_work_lane=~\"$lane\"}[$__interval] offset -$__interval) - (last_over_time(tasque_provider_cost_USD_total{tasque_work_lane=~\"$lane\"}[$__interval]) or last_over_time(tasque_provider_cost_USD_total{tasque_work_lane=~\"$lane\"}[$__interval] offset -$__interval) * 0)))",
          "legendFormat": "Cost",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "showPoints": "never",
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
