# Paths are relative to the directory the daemon starts in.
TASQUE2_DATA_DIR=data
TASQUE2_EXTENSIONS_DIR=extensions
TASQUE2_TIMEZONE=America/Los_Angeles

# Home location for the weather_now tool (Open-Meteo, no key).
TASQUE2_WEATHER_LATITUDE=32.7157
TASQUE2_WEATHER_LONGITUDE=-117.1611
TASQUE2_WEATHER_LOCATION_LABEL=San Diego, CA

# Providers. worker_kind "provider.default" runs on this provider.
TASQUE2_DEFAULT_PROVIDER=claude
# Profile for work whose runtime contract names none: low, medium, high, ultra.
TASQUE2_DEFAULT_MODEL_PROFILE=medium
# Model and reasoning effort per profile. Blank uses the built-in Claude defaults:
# low=claude-haiku-4-5, medium=claude-sonnet-5 (effort medium),
# high=claude-opus-5-5 (effort high), ultra=claude-fable-5-1 (effort high).
TASQUE2_CLAUDE_MODEL_LOW=
TASQUE2_CLAUDE_MODEL_MEDIUM=
TASQUE2_CLAUDE_MODEL_HIGH=
TASQUE2_CLAUDE_MODEL_ULTRA=
TASQUE2_CLAUDE_EFFORT_MEDIUM=
TASQUE2_CLAUDE_EFFORT_HIGH=
TASQUE2_CLAUDE_EFFORT_ULTRA=
# Codex needs a model per profile when it is used.
TASQUE2_CODEX_MODEL_LOW=
TASQUE2_CODEX_MODEL_MEDIUM=
TASQUE2_CODEX_MODEL_HIGH=
TASQUE2_CODEX_MODEL_ULTRA=

# Worker runs. Built-in tools a worker may use (comma-separated; blank = the standard set),
# tools it may never use, and the user-scope MCP servers (from ~/.claude.json) a run loads
# when its contract names none (blank = all of them).
TASQUE2_WORKER_TOOLS=
TASQUE2_WORKER_DISALLOWED_TOOLS=
TASQUE2_DEFAULT_MCP_SERVERS=
TASQUE2_WORKER_EXIT_GRACE_SECONDS=20

# Daemon.
TASQUE2_DAEMON_CONCURRENCY=2
TASQUE2_DAEMON_TICK_SECONDS=5
TASQUE2_DAEMON_LEASE_SECONDS=600

# Discord. The intake channel turns plain messages into work; results post to the jobs
# channel, workflow panels to chains, dead letters to dlq, the control panel to ops.
TASQUE2_DISCORD_TOKEN=
TASQUE2_DISCORD_INTAKE_CHANNEL_ID=
TASQUE2_DISCORD_OPS_CHANNEL_ID=
TASQUE2_DISCORD_JOBS_CHANNEL_ID=
TASQUE2_DISCORD_CHAINS_CHANNEL_ID=
TASQUE2_DISCORD_DLQ_CHANNEL_ID=
# Comma-separated user ids allowed to queue and control work. Blank allows everyone.
TASQUE2_DISCORD_ALLOWED_USER_IDS=
TASQUE2_DISCORD_MAX_ATTACHMENT_BYTES=26214400

# Memory recall embeddings: auto (OpenAI when a key is set, else a local hashing embedder),
# hash, openai, or none.
TASQUE2_EMBEDDING_PROVIDER=auto
TASQUE2_OPENAI_API_KEY=

# Retention: provider stream artifacts older than N days are deleted (their rows are kept,
# archived); per-run scratch directories older than N days are removed. 0 disables.
TASQUE2_ARTIFACT_RETENTION_DAYS=30
TASQUE2_ARTIFACT_RETENTION_KINDS=provider_stream
TASQUE2_SCRATCH_RETENTION_DAYS=7

# OpenTelemetry. auto exports over OTLP when an OTLP endpoint is set and stays off otherwise;
# otlp, console, off force a mode. The standard OTEL_* variables configure the exporter.
TASQUE2_TELEMETRY=auto
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Let Claude Code workers export their own metrics and logs to the same endpoint, tagged
# with the run's lane; traces add per-tool spans (beta).
TASQUE2_TELEMETRY_WORKER_EXPORT=true
TASQUE2_TELEMETRY_WORKER_TRACES=false
